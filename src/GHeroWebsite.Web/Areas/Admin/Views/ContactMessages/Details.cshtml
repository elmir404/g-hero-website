@model GHeroWebsite.Domain.Entities.Contact
@{
    ViewData["Title"] = "Message Details";
    Layout = "_Layout";
}

<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <a href="/Admin/ContactMessages" class="text-sakura-600 hover:text-sakura-900 mb-4 inline-block">← Back to Messages</a>
            <h1 class="text-3xl font-bold text-gray-900">Message Details</h1>
        </div>

        <div class="bg-white shadow rounded-lg overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
                <div class="flex justify-between items-center">
                    <div>
                        <h2 class="text-xl font-semibold text-gray-900">@Model.Name</h2>
                        <p class="text-sm text-gray-500">@Model.Email</p>
                    </div>
                    <div>
                        @if (Model.IsRead)
                        {
                            <span class="px-3 py-1 inline-flex text-sm leading-5 font-semibold rounded-full bg-green-100 text-green-800">Read</span>
                        }
                        else
                        {
                            <span class="px-3 py-1 inline-flex text-sm leading-5 font-semibold rounded-full bg-red-100 text-red-800">Unread</span>
                        }
                    </div>
                </div>
            </div>

            <div class="px-6 py-6">
                <div class="space-y-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Company</label>
                        <p class="text-gray-900">@(Model.Company ?? "Not provided")</p>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Date</label>
                        <p class="text-gray-900">@Model.CreatedAt.ToString("MMMM dd, yyyy 'at' HH:mm UTC")</p>
                    </div>

                    @if (Model.IsRead && Model.ReadAt.HasValue)
                    {
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Read At</label>
                            <p class="text-gray-900">@Model.ReadAt.Value.ToString("MMMM dd, yyyy 'at' HH:mm UTC")</p>
                        </div>
                    }

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Message</label>
                        <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                            <p class="text-gray-900 whitespace-pre-wrap">@Model.Message</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="px-6 py-4 border-t border-gray-200 bg-gray-50 flex justify-between">
                <div class="flex space-x-3">
                    @if (Model.IsRead)
                    {
                        <form asp-controller="ContactMessages" asp-action="MarkAsUnread" method="post" asp-route-id="@Model.Id">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="px-4 py-2 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700 transition-colors">
                                Mark as Unread
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="ContactMessages" asp-action="MarkAsRead" method="post" asp-route-id="@Model.Id">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">
                                Mark as Read
                            </button>
                        </form>
                    }
                </div>
                <form asp-controller="ContactMessages" asp-action="Delete" method="post" asp-route-id="@Model.Id" onsubmit="return confirm('Are you sure you want to delete this message?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors">
                        Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

