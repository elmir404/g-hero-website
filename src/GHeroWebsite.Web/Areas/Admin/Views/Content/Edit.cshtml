@model GHeroWebsite.Application.DTOs.ContentSectionDto
@{
    ViewData["Title"] = Model.Id.HasValue ? "Edit Content Section" : "New Content Section";
    Layout = "_Layout";
}

<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <a href="/Admin/Content" class="text-sakura-600 hover:text-sakura-900 mb-4 inline-block">← Back to Content Management</a>
            <h1 class="text-3xl font-bold text-gray-900">@ViewData["Title"]</h1>
        </div>

        <div class="bg-white shadow rounded-lg p-6">
            <form asp-action="Edit" method="post" class="space-y-6">
                @Html.AntiForgeryToken()
                @if (Model.Id.HasValue)
                {
                    <input type="hidden" asp-for="Id" />
                }

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="SectionKey" class="block text-sm font-medium text-gray-700 mb-2">
                            Section Key <span class="text-red-600">*</span>
                        </label>
                        <input asp-for="SectionKey" 
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-sakura-500 focus:border-transparent" 
                               placeholder="e.g., hero.title, philosophy.content" />
                        <span asp-validation-for="SectionKey" class="text-red-600 text-sm"></span>
                        <p class="mt-1 text-sm text-gray-500">Unique identifier for this content section</p>
                    </div>
                    <div>
                        <label asp-for="LanguageCode" class="block text-sm font-medium text-gray-700 mb-2">
                            Language <span class="text-red-600">*</span>
                        </label>
                        <select asp-for="LanguageCode" 
                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-sakura-500 focus:border-transparent">
                            @foreach (var lang in (string[])ViewBag.AvailableLanguages)
                            {
                                <option value="@lang">@(lang == "jp" ? "日本語 (Japanese)" : lang == "az" ? "Azərbaycan (Azerbaijani)" : "English")</option>
                            }
                        </select>
                        <span asp-validation-for="LanguageCode" class="text-red-600 text-sm"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="Title" class="block text-sm font-medium text-gray-700 mb-2">
                        Title
                    </label>
                    <input asp-for="Title" 
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-sakura-500 focus:border-transparent" 
                           placeholder="Section title" />
                    <span asp-validation-for="Title" class="text-red-600 text-sm"></span>
                </div>

                <div>
                    <label asp-for="Subtitle" class="block text-sm font-medium text-gray-700 mb-2">
                        Subtitle
                    </label>
                    <input asp-for="Subtitle" 
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-sakura-500 focus:border-transparent" 
                           placeholder="Section subtitle" />
                    <span asp-validation-for="Subtitle" class="text-red-600 text-sm"></span>
                </div>

                <div>
                    <label asp-for="Content" class="block text-sm font-medium text-gray-700 mb-2">
                        Content
                    </label>
                    <textarea asp-for="Content" 
                              rows="8"
                              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-sakura-500 focus:border-transparent resize-none" 
                              placeholder="Main content (HTML supported)"></textarea>
                    <span asp-validation-for="Content" class="text-red-600 text-sm"></span>
                    <p class="mt-1 text-sm text-gray-500">You can use HTML tags for formatting</p>
                </div>

                <div>
                    <label asp-for="AdditionalData" class="block text-sm font-medium text-gray-700 mb-2">
                        Additional Data (JSON)
                    </label>
                    <textarea asp-for="AdditionalData" 
                              rows="6"
                              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-sakura-500 focus:border-transparent font-mono text-sm resize-none" 
                              placeholder='{"items": ["Item 1", "Item 2"]}'></textarea>
                    <span asp-validation-for="AdditionalData" class="text-red-600 text-sm"></span>
                    <p class="mt-1 text-sm text-gray-500">Use JSON format for structured data (e.g., lists, arrays)</p>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="DisplayOrder" class="block text-sm font-medium text-gray-700 mb-2">
                            Display Order
                        </label>
                        <input asp-for="DisplayOrder" type="number" 
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-sakura-500 focus:border-transparent" />
                        <span asp-validation-for="DisplayOrder" class="text-red-600 text-sm"></span>
                        <p class="mt-1 text-sm text-gray-500">Lower numbers appear first</p>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            Status
                        </label>
                        <div class="mt-2">
                            <label class="inline-flex items-center">
                                <input asp-for="IsActive" type="checkbox" class="rounded border-gray-300 text-sakura-600 focus:ring-sakura-500" />
                                <span class="ml-2 text-sm text-gray-700">Active (visible on website)</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="flex justify-end space-x-3 pt-4 border-t">
                    <a href="/Admin/Content" class="px-6 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors">
                        Cancel
                    </a>
                    <button type="submit" class="px-6 py-2 bg-sakura-600 text-white rounded-lg hover:bg-sakura-700 transition-colors">
                        @(Model.Id.HasValue ? "Update" : "Create") Section
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

