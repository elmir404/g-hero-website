@{
    ViewData["Title"] = "Home - G-Hero Company";
    var sections = ViewBag.ContentSections as Dictionary<string, GHeroWebsite.Domain.Entities.ContentSection> ?? new Dictionary<string, GHeroWebsite.Domain.Entities.ContentSection>();
    
    // Helper function to get content by key with fallback
    string GetContent(string key, string fallback = "")
    {
        return sections.ContainsKey(key) && sections[key] != null ? (sections[key].Content ?? sections[key].Title ?? fallback) : fallback;
    }
    
    string GetTitle(string key, string fallback = "")
    {
        return sections.ContainsKey(key) && sections[key] != null ? (sections[key].Title ?? fallback) : fallback;
    }
    
    string GetSubtitle(string key, string fallback = "")
    {
        return sections.ContainsKey(key) && sections[key] != null ? (sections[key].Subtitle ?? fallback) : fallback;
    }
    
    // Helper to parse JSON array from AdditionalData
    List<string> GetJsonArray(string key)
    {
        if (!sections.ContainsKey(key) || sections[key] == null || string.IsNullOrEmpty(sections[key].AdditionalData))
            return new List<string>();
        
        try
        {
            var json = sections[key]!.AdditionalData;
            if (string.IsNullOrEmpty(json))
                return new List<string>();
            return System.Text.Json.JsonSerializer.Deserialize<List<string>>(json) ?? new List<string>();
        }
        catch
        {
            return new List<string>();
        }
    }
}

<section id="home" class="min-h-screen flex items-center justify-center bg-gradient-to-br from-sakura-50 to-teal-50 pt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 text-gray-900">
            <span class="text-sakura-600">@GetTitle("hero.title", "G-Hero Company")</span>
        </h1>
        <p class="text-xl md:text-2xl text-gray-700 mb-8 max-w-3xl mx-auto">
            @GetContent("hero.tagline", "Japanese Quality to the World, Global Potential to Japan")
        </p>
        <p class="text-lg text-gray-600 mb-12 max-w-2xl mx-auto">
            @GetContent("hero.description", "G-Hero Company is a global IT & solutions bridge connecting Japan and the world, dedicated to creating new value through innovative services.")
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="#contact" class="px-8 py-4 bg-gradient-to-r from-sakura-500 to-sakura-600 text-white rounded-full font-semibold text-lg hover:shadow-2xl hover:scale-105 transition-all duration-300">
                Contact Us
            </a>
            <a href="#domains" class="px-8 py-4 bg-white text-sakura-600 border-2 border-sakura-600 rounded-full font-semibold text-lg hover:shadow-2xl hover:scale-105 transition-all duration-300">
                View Services
            </a>
        </div>
    </div>
</section>

<section id="philosophy" class="py-20 lg:py-32 bg-gradient-to-b from-white to-sakura-50/30">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-3xl shadow-lg p-8 md:p-12 lg:p-16 border border-sakura-100">
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-8 text-gray-900">
                <span class="text-sakura-600">@GetTitle("philosophy.title", "Philosophy")</span>
            </h2>
            <div class="prose prose-lg max-w-none">
                <p class="text-gray-700 leading-relaxed text-lg md:text-xl whitespace-pre-line">
                    @GetContent("philosophy.content", "G-Hero Company Co., Ltd. was founded with the mission of creating new value in the international community and with the aim of becoming a bridge that delivers \"Japanese quality to the world, and the world's potential to Japan\". Through our diverse business domains, we contribute to the growth of our customers, partner companies, and local communities, striving to grow as a sustainable and trusted global company.")
                </p>
            </div>
        </div>
    </div>
</section>

<section id="mission" class="py-20 lg:py-32 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6 text-gray-900">
                <span class="text-teal-600">@GetTitle("mission.title", "Mission")</span>
            </h2>
        </div>
        <div class="bg-gradient-to-br from-teal-50 to-sakura-50 rounded-3xl shadow-lg p-8 md:p-12 lg:p-16 border border-teal-100">
            <div class="max-w-3xl mx-auto text-center">
                <p class="text-gray-700 leading-relaxed text-lg md:text-xl font-medium">
                    @GetContent("mission.content", "To become a \"bridge\" that connects countries, people, businesses, and opportunities. Based on reliable quality and sincere service, we create new value and future in the global market.")
                </p>
            </div>
        </div>
    </div>
</section>

<section id="vision" class="py-20 lg:py-32 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6 text-gray-900">
                <span class="text-sakura-600">@GetTitle("vision.title", "Vision")</span>
            </h2>
        </div>
        <div class="max-w-4xl mx-auto">
            @{
                var visionItems = GetJsonArray("vision.items");
                if (visionItems.Count == 0)
                {
                    visionItems = new List<string>
                    {
                        "Grow into a leading diversified global corporate group representing Asia.",
                        "Promote Japan's technology, culture, and services to the world and maximize their value.",
                        "Connect Japanese and overseas companies, investors, and talent to create the best environment for both sides.",
                        "Remain an innovative and trusted partner in the ever-changing global market."
                    };
                }
            }
            <ul class="space-y-6 text-left">
                @foreach (var item in visionItems)
                {
                    <li class="flex items-start">
                        <span class="text-sakura-600 mr-3 mt-1">•</span>
                        <span class="text-lg text-gray-700">@item</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</section>

<section id="values" class="py-20 lg:py-32 bg-gradient-to-b from-white to-sakura-50/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6 text-gray-900">
                <span class="text-sakura-600">@GetTitle("values.title", "Core Values")</span>
            </h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            @{
                var valuesItems = GetJsonArray("values.items");
                if (valuesItems.Count == 0)
                {
                    valuesItems = new List<string>
                    {
                        "Integrity|We conduct our business with transparency and integrity, in full compliance with laws and regulations.",
                        "Quality|We expand \"Japanese standards\" globally and deliver top quality in every business we operate.",
                        "Innovation|We go beyond existing frameworks to constantly create new value and business models.",
                        "Global Mindset|We leverage multicultural understanding and global awareness to enable cross-border collaboration.",
                        "Customer Success|We believe our growth comes from the success of our customers."
                    };
                }
            }
            @foreach (var valueItem in valuesItems)
            {
                var parts = valueItem.Split('|');
                var name = parts.Length > 0 ? parts[0] : valueItem;
                var description = parts.Length > 1 ? parts[1] : "";
                <div class="bg-white rounded-2xl shadow-lg p-6 border border-sakura-100">
                    <h3 class="text-xl font-bold text-sakura-600 mb-3">@name</h3>
                    <p class="text-gray-700">@description</p>
                </div>
            }
        </div>
    </div>
</section>

<section id="domains" class="py-20 lg:py-32 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6 text-gray-900">
                <span class="text-sakura-600">@GetTitle("domains.title", "Business Domains")</span>
            </h2>
            <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
                @GetSubtitle("domains.subtitle", "Our core business domains include:")
            </p>
        </div>
        <div class="max-w-4xl mx-auto">
            @{
                var domainItems = GetJsonArray("domains.items");
                if (domainItems.Count == 0)
                {
                    domainItems = new List<string>
                    {
                        "Attraction of domestic and overseas investors and legal consulting",
                        "Wholesale, retail, import and export of food products",
                        "E-commerce (EC site operation)",
                        "Logistics planning and operations",
                        "Export sales of Japanese cosmetics",
                        "Travel and tourism services",
                        "Automobile sales, leasing, and rental",
                        "Real estate sales, brokerage, and management",
                        "Overseas study support and education services",
                        "International exchange and dispatch of IT engineers and specialists",
                        "Hotel and accommodation booking and operations",
                        "Private lodging (minpaku) and simplified lodging business",
                        "Planning and operation of restaurants (cafes and restaurants)",
                        "Import and sales of alcoholic beverages",
                        "All related and ancillary businesses"
                    };
                }
            }
            <ul class="space-y-4 text-left">
                @foreach (var item in domainItems)
                {
                    <li class="flex items-start">
                        <span class="text-teal-600 mr-3 mt-1">•</span>
                        <span class="text-lg text-gray-700">@item</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</section>

<section id="about" class="py-20 lg:py-32 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-gradient-to-br from-sakura-50 to-teal-50 rounded-3xl shadow-lg p-8 md:p-12 lg:p-16 border border-sakura-100">
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-8 text-gray-900 text-center">
                <span class="text-teal-600">@GetTitle("about.title", "About G-Hero Company")</span>
            </h2>
            <p class="text-gray-700 leading-relaxed text-lg md:text-xl text-center max-w-3xl mx-auto">
                @GetContent("about.content", "G-Hero Company is a Japan-based global IT & multi-business bridge company. We combine international perspectives with Japanese quality standards to deliver optimal solutions to our clients and partners.")
            </p>
        </div>
    </div>
</section>

<section id="contact" class="py-20 lg:py-32 bg-gradient-to-b from-white to-sakura-50/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6 text-gray-900">
                <span class="text-sakura-600">Contact</span>
            </h2>
            <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
                Please feel free to contact us with any questions or inquiries.
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
            <!-- Contact Form -->
            <div class="bg-white rounded-3xl shadow-lg p-8 md:p-10 border border-sakura-100">
                <form asp-controller="Contact" asp-action="Submit" method="post" class="space-y-6">
                    @Html.AntiForgeryToken()
                    <div>
                        <label for="Name" class="block text-sm font-medium text-gray-700 mb-2">
                            Name <span class="text-sakura-600">*</span>
                        </label>
                        <input
                            type="text"
                            id="Name"
                            name="Name"
                            required
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-sakura-500 focus:border-transparent transition-all"
                            placeholder="Your Name"
                        />
                    </div>

                    <div>
                        <label for="Email" class="block text-sm font-medium text-gray-700 mb-2">
                            Email <span class="text-sakura-600">*</span>
                        </label>
                        <input
                            type="email"
                            id="Email"
                            name="Email"
                            required
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-sakura-500 focus:border-transparent transition-all"
                            placeholder="your.email@example.com"
                        />
                    </div>

                    <div>
                        <label for="Company" class="block text-sm font-medium text-gray-700 mb-2">
                            Company
                        </label>
                        <input
                            type="text"
                            id="Company"
                            name="Company"
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-sakura-500 focus:border-transparent transition-all"
                            placeholder="Your Company"
                        />
                    </div>

                    <div>
                        <label for="Message" class="block text-sm font-medium text-gray-700 mb-2">
                            Message <span class="text-sakura-600">*</span>
                        </label>
                        <textarea
                            id="Message"
                            name="Message"
                            required
                            rows="6"
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-sakura-500 focus:border-transparent transition-all resize-none"
                            placeholder="Your Message"
                        ></textarea>
                    </div>

                    <button
                        type="submit"
                        class="w-full px-8 py-4 bg-gradient-to-r from-sakura-500 to-teal-500 text-white rounded-full font-semibold text-lg hover:shadow-2xl hover:scale-105 transition-all duration-300"
                    >
                        Send Message
                    </button>
                </form>
            </div>

            <!-- Contact Information -->
            <div class="flex flex-col justify-center space-y-8">
                <div class="bg-gradient-to-br from-teal-50 to-sakura-50 rounded-3xl shadow-lg p-8 md:p-10 border border-teal-100">
                    <h3 class="text-2xl font-bold text-gray-900 mb-6">
                        Contact
                    </h3>
                    <div class="space-y-6">
                        <div class="flex items-start space-x-4">
                            <div class="flex-shrink-0">
                                <svg class="w-6 h-6 text-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                            </div>
                            <div>
                                <p class="text-gray-700 text-lg leading-relaxed">
                                    Chiyoda-ku, Tokyo, Japan
                                </p>
                            </div>
                        </div>

                        <div class="flex items-start space-x-4">
                            <div class="flex-shrink-0">
                                <svg class="w-6 h-6 text-sakura-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                </svg>
                            </div>
                            <div>
                                <p class="text-gray-700 text-lg">
                                    +81-3-0000-0000
                                </p>
                            </div>
                        </div>

                        <div class="flex items-start space-x-4">
                            <div class="flex-shrink-0">
                                <svg class="w-6 h-6 text-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                </svg>
                            </div>
                            <div>
                                <a
                                    href="mailto:info@g-hero-company.com"
                                    class="text-gray-700 text-lg hover:text-sakura-600 transition-colors"
                                >
                                    info@g-hero-company.com
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
